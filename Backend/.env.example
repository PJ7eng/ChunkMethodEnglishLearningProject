NODE_ENV=development
PORT=3000
# Local Docker Postgres only. Neon production URL belongs in Railway Variables, not Git.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chunk_learning?schema=public
JWT_SECRET=replace-with-at-least-32-random-bytes
# Local: Vite origin. Cloud: Pages HTTPS plus Capacitor Android WebView
# origin https://localhost (and http://localhost if Logcat shows that Origin).
# Comma-separated, no trailing slashes. Do not use *.
CORS_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173
APP_VERSION=development
# Keep false until confirm-button verify-email is proven with a real mailbox.
REQUIRE_EMAIL_VERIFICATION=false
RESEND_API_KEY=
# Must be a Resend-allowed From. Testing often uses the Resend onboarding address.
EMAIL_FROM=ChunkMaster <noreply@example.com>
OPENAI_API_KEY=
# DeepSeek (default). Reuse OPENAI_API_KEY for the DeepSeek secret, or set AI_API_KEY.
AI_BASE_URL=
AI_PROVIDER=
AI_MODEL=
OPENAI_MODEL=
GENERATION_DAILY_JOB_LIMIT=20
GENERATION_WORKER_ENABLED=true
GENERATION_REQUEST_TIMEOUT_MS=60000
RATE_LIMIT_PER_MINUTE=120
SENTRY_DSN=
SUPER_ADMIN_EMAIL=
ENABLE_SWAGGER=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chunklearning?schema=public"
PORT=3000
