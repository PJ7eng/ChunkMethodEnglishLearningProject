datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String                   @id @default(uuid())
  email               String                   @unique
  passwordHash        String
  name                String?
  role                UserRole                 @default(learner)
  emailVerifiedAt     DateTime?
  timezone            String                   @default("UTC")
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  preferences         UserPreference?
  learningProgress    LearningProgress[]
  dailyProgress       DailyProgress[]
  notes               Note[]
  sessions            UserSession[]
  verificationTokens  EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  auditEvents         AuditEvent[]             @relation("AuditActor")
}

model Note {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  english     String
  translation String
  category    String
  chunkId     String?
  chunk       Chunk?   @relation(fields: [chunkId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([chunkId])
}

model UserPreference {
  id              String  @id @default(uuid())
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyGoal       Int     @default(10)
  soundEnabled    Boolean @default(true)
  reminderEnabled Boolean @default(false)
  hapticEnabled   Boolean @default(true)
  autoNextEnabled Boolean @default(true)
}

enum ContentStatus {
  draft
  generating
  pending_review
  rejected
  published
  retired
}

enum UserRole {
  learner
  content_reviewer
  content_admin
  super_admin
}

model ContentPoolItem {
  id              String           @id @default(uuid())
  category        String
  difficulty      String
  status          ContentStatus    @default(draft)
  qualityScore    Float            @default(0.0)
  usageCount      Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  chunks          Chunk[]
  quizzes         QuizQuestion[]
  versions        ContentVersion[]
  generationJobId String?
  generationJob   GenerationJob?   @relation(fields: [generationJobId], references: [id], onDelete: SetNull)

  @@index([status, category, difficulty])
}

model Chunk {
  id                String             @id @default(uuid())
  contentPoolItemId String
  contentPoolItem   ContentPoolItem    @relation(fields: [contentPoolItemId], references: [id], onDelete: Cascade)
  phrase            String             @unique
  translation       String
  pinyin            String?
  category          String
  difficulty        String
  blank             String
  answer            String
  options           Json
  status            String             @default("active")
  examples          ChunkExample[]
  quizOptions       QuizOption[]
  learningProgress  LearningProgress[]
  notes             Note[]
}

model ChunkExample {
  id       String @id @default(uuid())
  chunkId  String
  chunk    Chunk  @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  sentence String
}

model QuizQuestion {
  id                   String          @id @default(uuid())
  contentPoolItemId    String
  contentPoolItem      ContentPoolItem @relation(fields: [contentPoolItemId], references: [id], onDelete: Cascade)
  prompt               String
  correctAnswerChunkId String
  difficulty           String
  status               String          @default("active")
  options              QuizOption[]
}

model QuizOption {
  id             String       @id @default(uuid())
  quizQuestionId String
  quizQuestion   QuizQuestion @relation(fields: [quizQuestionId], references: [id], onDelete: Cascade)
  chunkId        String
  chunk          Chunk        @relation(fields: [chunkId], references: [id])
  isCorrect      Boolean
  orderIndex     Int
}

model LearningProgress {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunkId        String
  chunk          Chunk     @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  mastered       Boolean   @default(false)
  needsReview    Boolean   @default(false)
  lastReviewedAt DateTime?
  reviewCount    Int       @default(0)
  answerCount    Int       @default(0)
  masteryScore   Float     @default(0.0)
  stability      Float     @default(0.0)
  difficulty     Float     @default(5.0)
  dueAt          DateTime  @default(now())
  lapseCount     Int       @default(0)
  lastResponseMs Int?

  @@unique([userId, chunkId])
  @@index([userId, dueAt])
}

model DailyProgress {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime @default(now())
  completedCount Int      @default(0)
  goal           Int
  streakDay      Int      @default(0)

  @@unique([userId, date])
}

enum JobStatus {
  pending
  running
  success
  failed
  cancelled
}

model GenerationJob {
  id             String            @id @default(uuid())
  jobType        String
  status         JobStatus         @default(pending)
  batchSize      Int
  startedAt      DateTime          @default(now())
  completedAt    DateTime?
  errorMessage   String?
  triggerReason  String
  category       String?
  difficulty     String?
  model          String?
  promptVersion  String?
  inputTokens    Int               @default(0)
  outputTokens   Int               @default(0)
  estimatedCost  Float             @default(0)
  idempotencyKey String?           @unique
  createdById    String?
  contentItems   ContentPoolItem[]
}

model UserSession {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  userAgent        String?
  ipAddress        String?

  @@index([userId, expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model ContentVersion {
  id                String          @id @default(uuid())
  contentPoolItemId String
  contentPoolItem   ContentPoolItem @relation(fields: [contentPoolItemId], references: [id], onDelete: Cascade)
  version           Int
  snapshot          Json
  createdById       String?
  createdAt         DateTime        @default(now())

  @@unique([contentPoolItemId, version])
}

model AuditEvent {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String?
  before     Json?
  after      Json?
  requestId  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}
